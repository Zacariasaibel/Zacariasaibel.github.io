---
import { projects } from "../data/projects";

const skillGroups = [
  { title: "Frontend", skills: ["Angular", "TypeScript", "JavaScript", "HTML", "CSS", "Astro"], context: "Angular im Einsatz:", projectTechnology: "Angular" },
  { title: "Backend", skills: ["Python", "Django", "Django REST Framework", "REST / JSON"], context: "Django REST Framework im Einsatz:", projectTechnology: "Django REST Framework" },
  { title: "Datenbanken & Werkzeuge", skills: ["SQLite", "MySQL", "Git", "GitHub", "Visual Studio Code"], context: "SQLite im Einsatz:", projectTechnology: "SQLite" },
];
---
<section id="skills" class="section skills" aria-labelledby="skills-title">
  <div class="container">
    <div class="section-heading"><h2 id="skills-title">Kenntnisse</h2><p>Diese Technologien nutze ich in der Umschulung und in eigenen Projekten.</p></div>
    <div class="skills-grid">{skillGroups.map((group) => (
      <article class="skill-card">
        <h3>{group.title}</h3>
        <ul class="tags">{group.skills.map((skill) => <li>{skill}</li>)}</ul>
        <div class="skill-context">
          <p>{group.context}</p>
          <ul>{projects.filter((project) => project.technologies.includes(group.projectTechnology)).map((project) => <li><a href={`/projekte/${project.slug}/`}>{project.name}</a></li>)}</ul>
        </div>
      </article>
    ))}</div>
  </div>
</section>
