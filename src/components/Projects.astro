---
import { projects } from "../data/projects";
---

<section id="projects" class="section projects" aria-labelledby="projects-title">
  <div class="container">
    <div class="section-heading">
      <h2 id="projects-title">Meine Projekte</h2>
    </div>
    <div class="project-grid">
      {projects.map((project) => (
        <article class="project-card" aria-labelledby={`card-${project.slug}`}>
          <img class="project-thumbnail" src={project.images[0].src} alt={project.images[0].alt} width={project.images[0].width} height={project.images[0].height} loading="lazy" decoding="async" />
          <div class="project-body">
            <h3 id={`card-${project.slug}`}>{project.name}</h3>
            <p>{project.summary}</p>
            <ul class="tags" aria-label="Technologien">
              {project.technologies.map((technology) => <li>{technology}</li>)}
            </ul>
            <a class="text-link project-detail-link" href={`/projekte/${project.slug}/`} aria-label={`${project.name}: Projekt ansehen`}>Projekt ansehen <span aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
