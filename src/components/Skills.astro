---
const skillGroups = [
	{
		title: "Frontend",
		skills: ["HTML", "CSS", "JavaScript", "TypeScript", "Angular", "Astro"],
	},
	{
		title: "Backend",
		skills: ["Python", "Django", "Django REST Framework", "REST APIs"],
	},
	{
		title: "Datenbank & Tools",
		skills: ["MySQL", "Git", "GitHub", "Visual Studio Code"],
	},
];
---

<section id="skills" class="skills section">
	<div class="container">
		<div class="section-heading">
			<p class="section-label">Kenntnisse</p>
			<h2>Technologien, die ich praktisch einsetze</h2>

			<p class="section-description">
				Mit diesen Technologien arbeite ich während meiner Umschulung und in
				eigenen Projekten. Dabei sammle ich vor allem Erfahrung mit Angular im
				Frontend sowie Python und Django im Backend.
			</p>
		</div>

		<div class="skills-grid">
			{
				skillGroups.map((group) => (
					<article class="skill-card">
						<h3>{group.title}</h3>

						<ul>
							{group.skills.map((skill) => <li>{skill}</li>)}
						</ul>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.skills {
		background-color: var(--color-background);
	}

	.section-heading {
		max-width: 42rem;
		margin-bottom: 3rem;
	}

	.section-label {
		margin-bottom: 0.75rem;
		color: var(--color-accent);
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	h2 {
		margin-bottom: 1rem;
		font-size: clamp(2rem, 4vw, 3rem);
		letter-spacing: -0.03em;
	}

	.section-description {
		margin-bottom: 0;
		color: var(--color-text-muted);
		font-size: 1.05rem;
	}

	.skills-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}

	.skill-card {
		padding: 2rem;
		background-color: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-large);
		box-shadow: var(--shadow-card);
	}

	h3 {
		margin-bottom: 1.5rem;
		font-size: 1.25rem;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		padding: 0;
		margin: 0;
		list-style: none;
		gap: 0.65rem;
	}

	li {
		padding: 0.45rem 0.75rem;
		background-color: var(--color-background);
		border: 1px solid var(--color-border);
		border-radius: 10rem;
		color: var(--color-text-muted);
		font-size: 0.9rem;
		font-weight: 600;
	}

	@media (max-width: 48rem) {
		.skills-grid {
			grid-template-columns: 1fr;
		}
	}
</style>